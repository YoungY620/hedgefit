{
  "name": "hedgefit-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@hedgefit/web",
    "build:web": "npm run build --workspace=@hedgefit/web",
    "studio:promo": "npm run studio --workspace=@hedgefit/promo",
    "render:promo": "npm run render --workspace=@hedgefit/promo"
  }
}
